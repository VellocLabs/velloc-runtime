  export type StreamingEvent = "process.spawn" | "turn.step"
  /** A glob over event names, or a negation. */
  export type EventGlob = \`\${string}*\${string}\` | \`!\${string}\`
  export type RenderSite = "AbovePrompt" | "AbovePromptList" | "AssistantMessage" | "Backdrop" | "CommandOutput" | "Pane" | "Placed" | "PromptHint" | "ToolGroup" | "ToolResult" | "ToolUse" | "UserMessage"
  export type RenderEvent = { [S in RenderSite]: ModRenderFrame & { component: S; props: ModRenderProps[S] } }[RenderSite]

  /** Each tool's input by name; a mod declares its own tools by merging into this. */
  export interface ToolInputs {}
  type ToolName = keyof ToolInputs & string
  export type ToolCall = [ToolName] extends [never]
    ? ToolCallEvent
    : { [K in ToolName]: { tool: K; tool_use_id: string; agentId?: string } & ToolInputs[K] }[ToolName]
  export type ToolCheck = [ToolName] extends [never]
    ? ToolCheckEvent
    : { [K in ToolName]: { tool: K; input: ToolInputs[K]; tool_use_id?: string; agentId?: string } }[ToolName]

  export type EventInput<K extends string> = K extends 'tool.call'
    ? ToolCall
    : K extends 'tool.check'
      ? ToolCheck
      : K extends 'ui.render'
        ? RenderEvent
        : K extends keyof ModEventShapes
          ? ModEventShapes[K]['e']
          : Record<string, unknown>
  export type EventResult<K extends string> = K extends keyof ModEventShapes ? ModEventShapes[K]['result'] : unknown

  /** The nouns a plugin adds to \`$\` at \`engine.create\`; declare them by merging. */
  export interface PluginNouns {}
  export type Dollar = Engine & PluginNouns

  export interface Next<E, R> {
    (e: E): R
    to(e: E, tier: TargetTier): R
    readonly signal: AbortSignal
    is(pattern: string): boolean
    readonly event: string
    readonly origin: Origin
    readonly trace: readonly TraceEntry[]
    readonly budget: NextBudget
    /** In a \`.catch\` handler: why the hook failed. */
    readonly error?: HookFailure
    readonly called?: boolean
  }

  export type PlainHook<K extends string> = (
    $: Dollar,
    e: EventInput<K>,
    next: Next<EventInput<K>, Promise<EventResult<K>>>,
  ) => EventResult<K> | Promise<EventResult<K>>
  export type StreamHook<K extends string> = (
    $: Dollar,
    e: EventInput<K>,
    next: Next<EventInput<K>, AsyncGenerator<unknown, EventResult<K>, unknown>>,
  ) => AsyncGenerator<unknown, EventResult<K>, unknown>
  export type Hook<K extends string> = K extends StreamingEvent ? StreamHook<K> : PlainHook<K>

  export interface Registration<K extends string> {
    catch(handler: Hook<K>): void
  }
  /** A partial of the event's argument the hook is called for. */
  export type Matcher<E> = { [P in keyof E]?: unknown }

  export interface On {
    <K extends RaisedEvent>(event: K, hook: Hook<K>): Registration<K>
    <K extends RaisedEvent>(event: K, matcher: Matcher<EventInput<K>>, hook: Hook<K>): Registration<K>
    (pattern: EventGlob, hook: Hook<string>): Registration<string>
    (pattern: EventGlob, matcher: Record<string, unknown>, hook: Hook<string>): Registration<string>
  }
  /** What a hooks module exports. */
  export type Register = (on: On, options: Readonly<Record<string, unknown>>) => void | Promise<void>

  export type ElementName = "Box" | "Button" | "Code" | "Input" | "Link" | "Markdown" | "Select" | "Svg" | "Text"
  export type UiElement = { readonly type: string; readonly props?: unknown; readonly children?: readonly unknown[] }
  export type UiElements = {
    readonly [N in ElementName]: (props: Record<string, unknown> & { children?: unknown }) => UiElement
  }

  export type StateRef = { plugin: string; key: string; id?: string }
  export type Atom<T> = { readonly ref: StateRef; readonly initial: T; readonly shape?: string }
  export type Derived<T> = { readonly sources: readonly unknown[]; readonly compute: (...values: any[]) => T }
  export function atom<T>(ref: StateRef, initial: T, options?: { shape?: string }): Atom<T>
  export function derive<T>(sources: readonly unknown[], compute: (...values: any[]) => T): Derived<T>
  export function memberOf<T>(family: Atom<T>, e: { requestId: string }): Atom<T>
  export function read<T>($: Dollar, source: Atom<T> | Derived<T>): Promise<T>
  export function update<T>($: Dollar, target: Atom<T>, change: (current: T) => T): Promise<T>
}
"
`;
